# Normalize line endings for text files
* text=auto eol=lf

# Web files
*.html text diff=html
*.css text diff=css
*.js text
*.json text
*.svg text
*.md text
*.yml text
*.yaml text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
